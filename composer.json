{
  "name": "yadddl/value-object",
  "description": "Yet another Value Object library — functional validation (PHP 8.5 pipes) and structural serialize/deserialize",
  "type": "library",
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "Christian Nastasi",
      "email": "christian.nastasi@gmail.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "ramsey/uuid": "^4.7"
  },
  "require-dev": {
    "vimeo/psalm": "^6.0",
    "friendsofphp/php-cs-fixer": "^3.16",
    "pestphp/pest": "^4.1"
  },
  "autoload": {
    "psr-4": {
      "Yadddl\\ValueObject\\": "src/",
      "Yadddl\\Serializer\\": "serializer/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Yadddl\\ValueObject\\Examples\\": "examples/",
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest",
    "test-coverage": "XDEBUG_MODE=coverage pest --coverage --min=100",
    "psalm": "psalm",
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "cs-fix": "php-cs-fixer fix --diff",
    "test:all": [
      "@cs-check",
      "@psalm",
      "@test-coverage"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
